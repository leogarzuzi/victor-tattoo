# Admin area settings. On Vercel, set these in Project → Settings → Environment Variables.
# For local testing, copy this file to .env.local (never commit .env.local).

# Login name for the admin panel.
ADMIN_USER=victor

# Temporary password (at least 8 characters). On the first login the panel asks for a new one.
# To reset a forgotten password, set a different value here and redeploy.
ADMIN_TEMP_PASSWORD=

# Long random text (at least 32 characters) used to sign the login cookie.
SESSION_SECRET=

# Created automatically when a Vercel Blob store is connected to the project.
# Leave empty locally to store uploads in the .local-data folder.
BLOB_READ_WRITE_TOKEN=
